<Window x:Class="TranscriptHelper.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Transcript Helper" Width="600" Height="410" MinWidth="540" MinHeight="100" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="CanResizeWithGrip" Closing="OnClosing" PreviewKeyDown="WindowKeyDown">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Foreground" Value="#FFE7E9EF"/><Setter Property="Background" Value="#FF272B33"/><Setter Property="BorderBrush" Value="#FF555D6C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF3B4351"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFE7E9EF"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#FF24262D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF555D6C"/><Setter Property="Padding" Value="6"/></Style>
</Window.Resources>
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border HorizontalAlignment="Center" Background="#EE25272C" BorderBrush="#FF646A75" BorderThickness="1" CornerRadius="25" Padding="10,6" Margin="0,0,0,8" MouseLeftButtonDown="DragHeader">
<StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="24" VerticalAlignment="Center" Margin="4,0,12,0"/><Button x:Name="CollapseButton" Content="⌄ Hide" Click="CollapseClick" ToolTip="Collapse panel (Ctrl+H)"/><Button x:Name="Start" Content="● Listen" Click="StartClick" Margin="6,0,0,0" ToolTip="Start microphone and speaker capture"/><Button x:Name="Stop" Content="■" Click="StopClick" IsEnabled="False" Margin="6,0,0,0" ToolTip="Stop capture"/><Button Content="×" Click="CloseClick" Margin="6,0,0,0" ToolTip="Close app"/></StackPanel></Border>
<Border x:Name="Shell" Grid.Row="1" Background="#D917171C" BorderBrush="#FF7D818C" BorderThickness="1" CornerRadius="18" Padding="14">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,10" MouseLeftButtonDown="DragHeader"><Button x:Name="ModeBadge" Content="Recap" Background="#FF084AB0" BorderBrush="#FF367DEB" DockPanel.Dock="Right" Click="RecapClick"/><StackPanel><TextBlock Text="TRANSCRIPT HELPER" FontSize="10" Foreground="#FFADB2BF"/><TextBlock x:Name="Status" Text="Idle — no capture" FontSize="11" TextWrapping="Wrap" MaxWidth="370"/></StackPanel></DockPanel>
<Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="Transcript" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"/><TextBlock x:Name="Partial" Grid.Row="1" Foreground="#FFADB2BF" TextWrapping="Wrap" FontStyle="Italic" Margin="0,5,0,0"/></Grid>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,10"><Button Content="✧ Assist" Click="AssistClick" Padding="9,5" Background="Transparent" BorderThickness="0"/><Button Content="What should I say?" Click="SuggestClick" Padding="9,5" Background="Transparent" BorderThickness="0"/><Button Content="Follow-up questions" Click="FollowUpClick" Padding="9,5" Background="Transparent" BorderThickness="0"/><Button Content="↻ Recap" Click="RecapClick" Padding="9,5" Background="Transparent" BorderThickness="0"/></StackPanel>
<Border Grid.Row="3" Background="#54282830" BorderBrush="#FF777985" BorderThickness="1" CornerRadius="13" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Prompt" Text="Summarize the conversation" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" MinHeight="34" ToolTip="Ask about the conversation (demo supports recap, actions, decisions)"/><Button Grid.Column="1" Content="▶" Click="AskClick" Background="#FF084AB0" BorderBrush="#FF367DEB" Width="34" Height="34" Padding="0" Margin="8,0,0,0" ToolTip="Submit (Ctrl+Enter)"/></Grid></Border>
<TextBlock Grid.Row="4" Text="Demo assistant · Copilot not connected" Foreground="#FFADB2BF" FontSize="10" Margin="4,6,0,6"/>
<Expander Grid.Row="5" Header="Audio setup &amp; transcript export" Foreground="#FFADB2BF" Expanded="SettingsExpanded" Collapsed="SettingsCollapsed"><StackPanel Margin="0,9,0,0">
<TextBlock Text="Output device — match Teams speakers/headphones" FontSize="11"/><ComboBox x:Name="Output" DisplayMemberPath="Name" Margin="0,5,0,8"/>
<CheckBox x:Name="Mic" Content="Capture default microphone (You)" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
<TextBlock Text="Optional Azure Speech key and region" FontSize="11"/><PasswordBox x:Name="Key" Margin="0,5,0,5" ToolTip="Azure Speech key"/><DockPanel><TextBox x:Name="LanguageCode" Text="en-US" Width="70" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Region" ToolTip="Speech resource region, e.g. westus2"/></DockPanel>
<TextBlock Text="No credentials: audio meters only. With credentials: audio sent to Azure Speech." TextWrapping="Wrap" Foreground="#FFFFCD86" FontSize="11" Margin="0,6,0,8"/>
<TextBlock Text="You" FontSize="11"/><ProgressBar x:Name="MicLevel" Maximum="1" Height="4" Margin="0,3,0,7"/><TextBlock Text="Meeting audio" FontSize="11"/><ProgressBar x:Name="SpeakerLevel" Maximum="1" Height="4" Margin="0,3,0,8"/>
<Button Content="Export transcript" Click="ExportClick" HorizontalAlignment="Left"/><TextBlock Text="Background opacity" FontSize="11" Margin="0,8,0,0"/><Slider Minimum="0.25" Maximum="1" Value="0.85" ValueChanged="OpacityChanged"/><TextBlock Text="Remote people share the Meeting audio label. Use headphones to reduce duplicate pickup." TextWrapping="Wrap" FontSize="10" Foreground="#FFADB2BF"/>
</StackPanel></Expander>
</Grid></Border></Grid></Window>